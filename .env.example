# =========================================================
# Guruji VPN - Environment Variables (copy to .env and fill)
# =========================================================

# --- Flask ---
FLASK_ENV=development
PORT=5000
# SECRET_KEY: generate a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=replace_me_with_a_long_random_secret

# --- Database ---
# MongoDB connection string (optional fallback to in-memory store if not set)
MONGO_URI=mongodb://localhost:27017/guruji_vpn

# --- Tailscale ---
# Tailscale OAuth client / API credentials (optional, for real device/exit-node mgmt)
# TAILSCALE_API_KEY=
# TAILSCALE_TAILNET=
# TAILSCALE_EXIT_NODE_ID=in-mum-01

# --- PhonePe Payment Gateway ---
# These are REQUIRED for live PhonePe payments.
# The app is fully functional in "simulation" mode when these are unset.
# To enable live payments, set them and set PHONEPE_ENABLED=true.

# Merchant ID provided by PhonePe (do NOT expose in frontend)
PHONEPE_MERCHANT_ID=
# Salt key provided by PhonePe (do NOT expose in frontend)
PHONEPE_SALT_KEY=
# Salt index (0 or 1) provided by PhonePe
PHONEPE_SALT_INDEX=1
# Merchant ID used to prefix order ids, e.g. "GURUJI"
PHONEPE_MERCHANT_PREFIX=GURUJI

# PhonePe API environment:
#   https://api.phonepe.com/apis/hermes/   (production)
#   https://api-preprod.phonepe.com/apis/pg-sandbox/  (sandbox/testing)
PHONEPE_API_BASE=https://api-preprod.phonepe.com/apis/pg-sandbox/

# Set to "true" to route payment create/verify through the real PhonePe gateway.
# When "false" (default), payment endpoints run in safe simulation mode.
PHONEPE_ENABLED=false

# Public-facing redirect URLs used by PhonePe's callback/redirect flow
# PHONEPE_REDIRECT_URL=https://vpn.gurujicorp.org/#dashboard
# PHONEPE_CALLBACK_URL=https://vpn.gurujicorp.org/api/payment/callback

# Secret to sign local simulation callbacks (so the sim can't be trivially forged)
# PHONEPE_SIM_SIGNING_SALT=replace_me_2
